---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import "../styles/scroll-fade.css";

const title = "A Pattern Language";
const subject = "human society";
const description = `Which generates a ${subject} and the structures to support it.`;

const patternsRaw = await getCollection("patterns");

// Sort by number (nullish last)
const patterns = patternsRaw.sort((a, b) => {
  const left = a.data.number ?? Number.POSITIVE_INFINITY;
  const right = b.data.number ?? Number.POSITIVE_INFINITY;
  return left - right;
});

// Build id -> title map for resolving references
const titleById = new Map(patterns.map((p) => [p.id, p.data.title] as const));
---

<Base title={title} description={description}>
  <div class="patterns-layout">
    <div class="site-header">
      <h1>{title}</h1>
      <form class="pattern-search" role="search">
        <p>
          <em>
            Which generates a{" "}
            <input
              type="search"
              name="q"
              placeholder={subject}
              aria-label="What are you designing?"
              autocomplete="off"
              size={subject.length}
            />{" "}
            and the structures to support it.
          </em>
        </p>
      </form>
    </div>

    <ol class="pattern-list">
      {patterns.map(async (pattern) => {
        const { Content } = await render(pattern);
        const supports = pattern.data.supports.flatMap((id) => {
          const title = titleById.get(id);
          return title ? [{ id, title }] : [];
        });
        const dependsOn = pattern.data.dependsOn.flatMap((id) => {
          const title = titleById.get(id);
          return title ? [{ id, title }] : [];
        });

        return (
          <li id={pattern.id}>
            <section class="pattern-wrapper">
              <h2 class="pattern-header">
                <span class="pattern-name">
                  {pattern.data.number !== undefined && (
                    <span class="pattern-number">#{pattern.data.number}. </span>
                  )}
                  {pattern.data.title}
                </span>
                <span class="pattern-significance">
                  {Array.from({ length: pattern.data.significance }).map(() => (
                    <svg
                      viewBox="0 0 200 200"
                      xmlns="http://www.w3.org/2000/svg"
                      aria-hidden="true"
                    >
                      <path d="M100 157.7L161.8 195L145.4 124.7L200 77.4L128.1 71.3L100 5L71.9 71.3L0 77.4L54.6 124.7L38.2 195L100 157.7Z" />
                    </svg>
                  ))}
                </span>
              </h2>

              {supports.length > 0 && (
                <ul class="link-list">
                  <li>
                    <em>Supports:</em>
                  </li>
                  {supports.map((ref) => (
                    <li>
                      <a href={`#${ref.id}`}>{ref.title}</a>
                    </li>
                  ))}
                </ul>
              )}

              <Content />

              {dependsOn.length > 0 && (
                <ul class="link-list">
                  <li>
                    <em>Depends on:</em>
                  </li>
                  {dependsOn.map((ref) => (
                    <li>
                      <a href={`#${ref.id}`}>{ref.title}</a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          </li>
        );
      })}
    </ol>

    <nav class="pattern-nav">
      <ol class="scroll-fade no-scrollbar">
        {patterns.map((pattern) => (
          <li>
            <span class="nav-number">{pattern.data.number}</span>
            <a href={`#${pattern.id}`}>{pattern.data.title}</a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</Base>

<script>
  import type { SearchResponse } from "../lib/pattern-search";

  (() => {
    const form = document.querySelector(".pattern-search");
    const input = form?.querySelector("input[type=search]");
    if (
      !(form instanceof HTMLFormElement) ||
      !(input instanceof HTMLInputElement)
    ) {
      return;
    }

    const items = Array.from(
      document.querySelectorAll<HTMLLIElement>(".pattern-list > li[id]"),
    );
    const navItems = Array.from(
      document.querySelectorAll<HTMLLIElement>(".pattern-nav li"),
    ).flatMap((item) => {
      const href = item.querySelector("a")?.getAttribute("href");
      return href?.startsWith("#") ? [{ item, id: href.slice(1) }] : [];
    });
    const patternLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.link-list a[href^="#"]'),
    ).map((link) => ({ link, id: link.getAttribute("href")?.slice(1) ?? "" }));

    const setLinkDisabled = (link: HTMLAnchorElement, disabled: boolean) => {
      if (disabled) {
        link.setAttribute("aria-disabled", "true");
        link.setAttribute("tabindex", "-1");
      } else {
        link.removeAttribute("aria-disabled");
        link.removeAttribute("tabindex");
      }
    };

    const DEBOUNCE_MS = 400;
    let controller: AbortController | undefined;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const showAll = () => {
      items.forEach((item) => (item.hidden = false));
      navItems.forEach(({ item }) => (item.hidden = false));
      patternLinks.forEach(({ link }) => setLinkDisabled(link, false));
    };

    const showMatches = (ids: Set<string>) => {
      items.forEach((item) => (item.hidden = !ids.has(item.id)));
      navItems.forEach(({ item, id }) => (item.hidden = !ids.has(id)));
      patternLinks.forEach(({ link, id }) =>
        setLinkDisabled(link, !ids.has(id)),
      );
    };

    const search = async () => {
      controller?.abort();
      const query = input.value.trim();
      if (query === "") {
        showAll();
        return;
      }
      controller = new AbortController();
      const { signal } = controller;
      try {
        const response = await fetch(
          `/api/search?q=${encodeURIComponent(query)}`,
          { signal },
        );
        if (!response.ok) {
          throw new Error(`Search failed with status ${response.status}`);
        }
        const result: SearchResponse = await response.json();
        showMatches(new Set(result.matches.map((match) => match.id)));
      } catch (error) {
        if (signal.aborted) {
          return;
        }
        console.error(error);
      }
    };

    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(search, DEBOUNCE_MS);
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      clearTimeout(timer);
      void search();
    });
  })();

  (() => {
    if (typeof window === "undefined") {
      return;
    }

    if (window.CSS?.supports?.("selector(:target-current)")) {
      return;
    }

    const nav = document.querySelector(".pattern-nav");
    if (!(nav instanceof HTMLElement)) {
      return;
    }

    const links = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'),
    );

    if (links.length === 0) {
      return;
    }

    type NavTarget = {
      id: string;
      link: HTMLAnchorElement;
      target: HTMLElement;
    };

    const targets: NavTarget[] = links.flatMap((link) => {
      const href = link.getAttribute("href");
      if (!href) {
        return [];
      }
      const id = decodeURIComponent(href.slice(1));
      if (!id) {
        return [];
      }
      const target = document.getElementById(id);
      if (!target) {
        return [];
      }
      return [{ id, link, target }];
    });

    if (targets.length === 0) {
      return;
    }

    const inBand = new Set();
    const orderedIds = targets.map((item) => item.id);
    const linkById = new Map(targets.map((item) => [item.id, item.link]));
    const targetById = new Map(targets.map((item) => [item.id, item.target]));

    const setCurrent = (id: string) => {
      links.forEach((link) => {
        if (link.getAttribute("href") === `#${id}`) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const resolveCurrentFromScroll = () => {
      const focusLine = window.innerHeight * 0.35;
      let currentId = orderedIds[0];

      orderedIds.forEach((id) => {
        const target = targetById.get(id);
        if (!target) {
          return;
        }
        if (target.getBoundingClientRect().top <= focusLine) {
          currentId = id;
        }
      });

      return currentId;
    };

    const syncCurrent = () => {
      const visibleId = orderedIds.find((id) => inBand.has(id));
      setCurrent(visibleId ?? resolveCurrentFromScroll());
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          if (entry.isIntersecting) {
            inBand.add(id);
          } else {
            inBand.delete(id);
          }
        });
        syncCurrent();
      },
      {
        rootMargin: "-35% 0px -55% 0px",
        threshold: 0,
      },
    );

    targets.forEach(({ target }) => {
      observer.observe(target);
    });

    const syncFromHash = () => {
      const hash = decodeURIComponent(window.location.hash.slice(1));
      if (hash && linkById.has(hash)) {
        setCurrent(hash);
        return;
      }
      syncCurrent();
    };

    window.addEventListener("hashchange", syncFromHash, { passive: true });
    syncFromHash();
  })();
</script>

<style>
  .patterns-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      ". header"
      "nav main";
    column-gap: 3rem;
  }

  .site-header {
    grid-area: header;
  }

  .site-header h1 {
    margin-top: 2em;
  }

  .pattern-search input {
    appearance: none;
    font: inherit;
    color: var(--color-accent);
    background: none;
    border: none;
    text-decoration: underline;
    padding: 0;
    margin: 0;
    min-width: 1ch;
    field-sizing: content;
    text-decoration-style: double;
    text-decoration-thickness: 0.75px;
    text-underline-offset: 2px;
  }

  .pattern-search input::placeholder {
    color: inherit;
    opacity: 1;
    transition: opacity 150ms ease-out;
  }

  .pattern-search input:focus::placeholder {
    opacity: 0.5;
  }

  .pattern-search input::-webkit-search-cancel-button {
    display: none;
  }

  .pattern-search input:focus {
    outline: none;
  }

  .pattern-list {
    grid-area: main;
    list-style: none;
    margin-top: 0;
    padding-bottom: 6rem;
  }

  .pattern-list > li {
    max-width: 100%;
    overflow-x: auto;
    margin: 0 -0.5em;
    padding-inline: 0.5em;
  }

  .pattern-list > li:first-child {
    margin-top: 0;
  }

  .pattern-number {
    white-space: nowrap;
  }

  .pattern-list h2 {
    border-top: 2px solid currentColor;
    margin-top: 2rem;
    padding-top: 2rem;
  }

  .pattern-nav {
    grid-area: nav;
  }

  .pattern-nav ol {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.6em 0.75em;
    margin: 3.5rem 0 2rem;
    padding: 0.5rem 1rem 2rem;
    max-height: calc(100vh - 4rem);
    position: sticky;
    top: 2rem;
    overflow-y: auto;
    list-style: none;
  }

  .pattern-nav li {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
    font-size: 0.8em;
    line-height: 1.5;
    margin: 0;
  }

  .pattern-nav li[hidden] {
    display: none;
  }

  .nav-number {
    font-family: var(--font-mono);
    font-size: 0.9em;
    text-align: right;
    color: var(--color-text-secondary);
  }

  .pattern-nav a {
    display: inline-block;
  }

  .pattern-nav a[aria-current="location"] {
    color: white;
  }

  .pattern-nav a[aria-current="location"]::before {
    opacity: 1;
  }

  @supports selector(:target-current) {
    .pattern-nav ol {
      scroll-target-group: auto;
    }

    .pattern-nav a:target-current {
      color: white;
    }

    .pattern-nav a:target-current::before {
      opacity: 1;
    }
  }

  .pattern-wrapper .pattern-header {
    display: flex;
  }

  .pattern-wrapper .pattern-name {
    flex: 1;
  }

  .pattern-wrapper .pattern-significance {
    justify-self: flex-end;
    white-space: nowrap;
    margin-left: 0.5em;
  }

  .pattern-wrapper .pattern-significance svg {
    width: 0.9em;
    text-align: baseline;
    position: relative;
    top: 2px;
  }

  .pattern-wrapper .pattern-significance:empty {
    display: none;
  }

  .link-list {
    list-style-type: none;
    padding: 0;
    display: inline-flex;
    flex-flow: row wrap;
  }

  .link-list a[aria-disabled="true"] {
    opacity: 0.5;
    pointer-events: none;
  }

  .link-list > li {
    margin: 0;
    flex: 0 0 auto;
    padding-right: 1rem;
    max-width: 100%;
  }

  @media (max-width: 600px) {
    .site-header {
      text-align: center;
    }

    .site-header h1 {
      margin-top: 1.5em;
    }

    .patterns-layout {
      display: flex;
      flex-direction: column;
    }

    .pattern-nav {
      display: none;
    }

    .pattern-wrapper .pattern-header {
      flex-wrap: wrap;
    }

    .pattern-wrapper .pattern-significance {
      flex: 1 0 100%;
      text-align: center;
      margin: 1rem 0 0;
    }
  }
</style>
